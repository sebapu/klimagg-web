# klimagg-web — example environment
# Copy this file to `.env` for local development.
# Never commit `.env`.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

PROJECT_NAME="Open Draft Demo"
PUBLIC_BASE_URL="http://localhost:8000"

# The public distribution supports SQLite only.
DATABASE_URL="sqlite:///./klimagg-web.db"


# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# There is exactly one authentication path:
# Magic Link -> JWT -> User.is_admin for administrative authorization.
#
# There is no separate admin password, HTTP Basic Auth, or dev-auth bypass.

# Local/demo default: do not send mail; expose the generated login URL in the API
# response so the normal Magic-Link callback can still be tested.
AUTH_MAGIC_LINK_EMAIL_ENABLED=false
AUTH_EXPOSE_LOGIN_URL=true

MAGIC_LINK_TOKEN_LIFETIME_MINUTES=30
MAGIC_LINK_MAX_PER_EMAIL_PER_HOUR=3
MAGIC_LINK_MAX_PER_IP_PER_HOUR=10
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Development-only convenience. Keep false unless intentionally testing without
# the normal comment quota.
KGG_DEV_DISABLE_COMMENT_QUOTA=false


# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# Replace before any public deployment.
JWT_SECRET_KEY="CHANGE_ME_BEFORE_DEPLOYMENT"
JWT_ALGORITHM="HS256"

ENABLE_SECURITY_HEADERS=true

# Same-origin local default.
BACKEND_CORS_ORIGINS='["http://localhost:8000"]'


# -----------------------------------------------------------------------------
# Privacy-friendly analytics
# -----------------------------------------------------------------------------

ENABLE_ANALYTICS=true

# Replace with a random installation-specific value before public deployment.
ANALYTICS_SALT="CHANGE_ME_BEFORE_DEPLOYMENT"

# Set true only when the application is actually behind a trusted reverse proxy
# that overwrites X-Forwarded-For.
ANALYTICS_TRUST_X_FORWARDED_FOR=false


# -----------------------------------------------------------------------------
# Legal / operator information
# -----------------------------------------------------------------------------

# Required for a real public deployment. Keep instance-specific legal data here,
# not in templates or config.py defaults.
LEGAL_PROVIDER_NAME=""
LEGAL_PROVIDER_ADDRESS=""
LEGAL_CONTENT_RESPONSIBLE=""
LEGAL_PRIVACY_AUTHORITY_NAME=""
LEGAL_PRIVACY_AUTHORITY_ADDRESS=""
LEGAL_NOTICE_DATE=""


# -----------------------------------------------------------------------------
# SMTP
# -----------------------------------------------------------------------------

# Required only when AUTH_MAGIC_LINK_EMAIL_ENABLED=true.
SMTP_HOST="smtp.example.invalid"
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=20
SMTP_USERNAME="demo@example.invalid"
SMTP_PASSWORD="CHANGE_ME_IF_ENABLED"


# -----------------------------------------------------------------------------
# Mail role addresses
# -----------------------------------------------------------------------------

# Replace example.invalid values when mail delivery is enabled.
MAIL_INFO_ADDRESS="info@example.invalid"
MAIL_LOGIN_ADDRESS="login@example.invalid"
MAIL_KONTAKT_ADDRESS="kontakt@example.invalid"
MAIL_DATENSCHUTZ_ADDRESS="datenschutz@example.invalid"
MAIL_ADMIN_ADDRESS="admin@example.invalid"
MAIL_NOREPLY_ADDRESS="noreply@example.invalid"

# Optional routing overrides. When empty, mail.py falls back to the corresponding
# role addresses above.
MAIL_CONTACT_FORM_TO=""
MAIL_INTEREST_FORM_TO=""
MAIL_DATENSCHUTZ_FORM_TO=""
MAIL_ADMIN_ALERT_TO=""


# -----------------------------------------------------------------------------
# Admin web update / GitHub
# -----------------------------------------------------------------------------

# Optional. When owner/name are empty, the backend can infer the repository from
# the local Git remote. A token is only needed when the GitHub API requires it.
GITHUB_REPO_OWNER=""
GITHUB_REPO_NAME=""
GITHUB_API_TOKEN=""
